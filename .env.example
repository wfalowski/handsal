# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://handsal:handsal_dev@localhost:5434/handsal

# ── Public URL ───────────────────────────────────────────────────────────────
# Base URL this instance is reachable at. Tenant issuers are derived from it:
#   iss = ${PUBLIC_URL}/t/<tenant-slug>
# Must be https:// when NODE_ENV=production.
PUBLIC_URL=http://localhost:3000

# ── Secrets ──────────────────────────────────────────────────────────────────
# DEV-ONLY placeholder, rejected at startup when NODE_ENV=production.
# Generate per environment:  openssl rand -hex 32   (exactly 64 hex chars)
# Encrypts tenant signing keys at rest AND derives the admin session HMAC key.
KEY_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: create the first super-admin on startup when admin_users is empty.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-start

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Dev only: Vite dev server origin. In production the SPA is same-origin.
CORS_ORIGINS=http://localhost:5173
# Behind a reverse proxy, set true so client IPs come from X-Forwarded-For.
# Headers are ignored unless the TCP peer is loopback, private, link-local or CGNAT.
TRUST_PROXY=false
TRUST_PROXY_HOP_COUNT=1
# Serve the admin UI + /api (default true). Set false for a headless issuer.
ENABLE_ADMIN_PANEL=true
# Display name in the admin UI and the browser tab. Blank counts as unset.
# INSTANCE_NAME=Handsal - Delvero
# Short badge so you can tell deployments apart. Letters, digits, ".", "_" or "-".
# INSTANCE_ENVIRONMENT=PRE

# ── Tuning (optional) ────────────────────────────────────────────────────────
# RATE_LIMIT_TOKEN_IP_MAX=600         # req/min per IP on /oauth/token
# RATE_LIMIT_TOKEN_CLIENT_MAX=600     # req/min per client_id on /oauth/token
# TOKEN_EVENTS_RETENTION_DAYS=30
