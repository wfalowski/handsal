{
  "name": "@handsal/sdk",
  "version": "0.2.0",
  "description": "Request Handsal client-credentials tokens and verify ES256 access tokens.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfalowski/handsal.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/wfalowski/handsal/blob/main/docs/sdk.md",
  "bugs": {
    "url": "https://github.com/wfalowski/handsal/issues"
  },
  "keywords": [
    "handsal",
    "oauth",
    "oauth2",
    "jwt",
    "jwks",
    "es256"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prepublishOnly": "echo 'Publish from the repo root: node scripts/publish-packages.mjs' >&2 && exit 1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
