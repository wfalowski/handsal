{
  "name": "handsal",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfalowski/handsal.git"
  },
  "scripts": {
    "dev": "turbo dev --filter=@handsal/api --filter=@handsal/web",
    "site": "pnpm --filter @handsal/site dev",
    "build": "turbo build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "typecheck": "turbo typecheck",
    "smoke": "bash scripts/smoke.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @handsal/db generate",
    "db:migrate": "pnpm --filter @handsal/db migrate",
    "db:seed": "pnpm --filter @handsal/db seed",
    "prepare": "husky || true",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "turbo": "^2.9.18",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "//onlyBuiltDependencies": "Allowlist of dependencies permitted to run install/postinstall lifecycle scripts. Every other package's build scripts are blocked, so a malicious (transitive) dependency cannot execute arbitrary code during `pnpm install`. Keep this to the minimal set that genuinely needs a native/binary build (verified: these are the only two packages in the tree with install scripts).",
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
